# ---- Node / 前端 ----
node_modules/
dist/
dist-ssr/
.vite/
.vitest/
coverage/
*.tsbuildinfo
.eslintcache

# ---- 日志 / 临时探针文件 ----
*.log
npm-debug.log*
_*.txt
.tmp-edge/

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
*.local

# ---- 后端产物（Phase 8+） ----
/backend/bin/

# ---- Python 工具字节码（tools/*.py 被 verify 脚本反复 import） ----
__pycache__/
*.pyc

# ---- Agent 探针产物（相机反解机构的中间图，可由 tools/ 重新生成） ----
# 注意：/.workbuddy/memory/ 是要入库的（与 MeArm-Device / MeArm-RemoteControl 约定一致）
/.workbuddy/analysis/
/.workbuddy/captures/
# probe/：SO-101 Phase 0 的只读探测产物（URDF/MJCF 结构 dump、网格清单等，可重算）
/.workbuddy/probe/

# ---- 探针产物归档（analysis/ 清理时打的 tarball，体积大且可重算，绝不入库） ----
# 实测此目录若非显式忽略，`git add -A` 会把数百 MB 的 tarball 吞进仓库。
/.workbuddy/_archive/

# ---- MuJoCo 轨临时探针产物（全部可重算，故不入库） ----
# e2e-sim.yaml / e2e-mujoco.yaml：由 backend/config.yaml 派生的隔离端口配置
#   （8090 上可能有正在驱动真机的实例，e2e 不能复用，必须另起 8091）
# sim-runs/：record.py 的演示输出（JSONL/CSV 样例，跑一次 --record 即可重建）
# ws-probe.mjs：WebSocket 全链路探针脚本（做法已记在 .workbuddy/memory/）
/.workbuddy/e2e-sim.yaml
/.workbuddy/e2e-mujoco.yaml
/.workbuddy/sim-runs/
/.workbuddy/ws-probe.mjs

# ---- 无头浏览器 profile（e2e / CDP 探针产生，纯缓存垃圾） ----
**/_edge_profile/
**/_edge[0-9]*/

# ---- 诊断工具的产物（可重算，故不入库） ----
# core/tools/out/：ws_scan_mearm_v1.py 的网格扫描输出（234498 采样点 JSON）。
#   重跑 ws_scan_mearm_v1.py 即可重建；入库只会让 diff 噪音化。
/core/tools/out/
